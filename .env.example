# Copia este fichero a .env (no se versiona) y rellena lo que uses.

# Credenciales de la API de Wyscout/Hudl (https://www.hudl.com/products/wyscout)
# para activar el proveedor Wyscout de la app.
WYSCOUT_CLIENT_ID=
WYSCOUT_CLIENT_SECRET=

# Dónde guardar la caché de datos descargados (opcional).
# Por defecto: data/cache relativo al directorio de trabajo.
# FUTBOL_ANALYTICS_CACHE=data/cache
