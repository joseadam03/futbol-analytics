# Copia este fichero a .env (no se versiona) y rellena lo que uses.

# Credenciales de la API de Wyscout/Hudl (https://www.hudl.com/products/wyscout)
# para activar el proveedor Wyscout de la app.
WYSCOUT_CLIENT_ID=
WYSCOUT_CLIENT_SECRET=

# Token de Sportmonks (https://www.sportmonks.com/) para enriquecer el
# Buscador con estadísticas de temporada (goles, asistencias, minutos) de
# jugadores fuera de los open data. No trae coordenadas de jugada, así que
# no alimenta el radar ni el mapa de calor — solo la ficha del Buscador.
SPORTMONKS_API_TOKEN=

# Dónde guardar la caché de datos descargados (opcional).
# Por defecto: data/cache relativo al directorio de trabajo.
# FUTBOL_ANALYTICS_CACHE=data/cache

# Modo demo: añade el proveedor "Demo (liga sintética)" y lo usa por defecto.
# Arranca al instante y sin red — útil para enseñar la app o desarrollar.
# FUTBOL_ANALYTICS_FAKE=1
